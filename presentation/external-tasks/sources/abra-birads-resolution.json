  "source_roles": {
    "helper": "visual: MR series list and viewer/preprocessor; oracle: query_birads_model returns answer-bearing constructed findings, a different condition",
    "input": "Duke Breast MRI study and MR series; source-manifest MR series for Breast_MRI_008 are real record metadata, no task-matched DICOM pixels bundled",
    "output": "structured submit_birads_report fields; no participant report retained",
    "reference": "Generated report field derivation from clinical XLSX plus downloaded DICOM UIDs. No generated report or patient targets retained; the teaching derivation explains general code rules only after explicit reveal.",
    "scorer": "weighted agreement with constructed fields, optional quadrant changes denominator; no independent clinical grading",
    "runtime_visibility": "TaskLoader loads task YAML containing expected_outcome/oracle_data; TaskWorker builds agent system prompt from task_description plus initial viewer context. It dispatches query_birads_model to _query_oracle and validates series UID before returning overview. This is source-read visibility, not a live filesystem isolation audit."
  },
  "task_contract": {
    "fields": [
      "laterality",
      "lesion_count",
      "birads_category",
      "enhancement_present",
      "optional lesion_quadrant"
    ],
    "oracle": "tier3 query_birads_model returns exact report-derived fields for matching DCE UID, vision false, 10 turns",
    "scorer_weights": {
      "birads_category": 0.3,
      "enhancement_present": 0.15,
      "laterality": 0.25,
      "lesion_count": 0.2,
      "lesion_quadrant_optional": 0.1
    },
    "visual": "tier4 requires matching report and MR series, vision true, breast_mri preprocessor, 20 turns, submit_birads_report",
    "reference_derivation": {
      "category": "assign 5 by code, no explicit MRI BI-RADS column",
      "enhancement": "assign true by code, no measured pre/post signal assertion",
      "lesion_count": "2 when multifocal flag is true, else 1; not independently enumerated lesions",
      "laterality": "L/R normalization, position fallback and bilateral override from clinical table",
      "quadrant": "custom clock/text mapping; not an adjudicated image annotation",
      "dce_series": "keyword priority scans series descriptions, then any-MR fallback; source manifest row order is not DCE time"
    },
    "oracle_runtime": "query_birads_model(series_uid=...) returns task.oracle_data.overview for exact matching series UID; no inference or slice-level BI-RADS observations are performed",
    "preprocessing": "breast_mri uses MRI 1st/99th percentile display window, conditional non-default rescale, flat-range fallback; normalized display signal is not HU or an enhancement measurement"
  },
  "task_run": false,
