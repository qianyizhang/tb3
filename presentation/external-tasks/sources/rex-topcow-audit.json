    {
      "id": "geometry",
      "observation": "Different-size predictions are nearest-neighbor resampled into reference geometry. Then the metric function casts both images to UInt8 and overwrites prediction metadata with CopyInformation. A source preprocessing-fragment fixture drops a +100mm origin and truncates 11.5/12.5 to 11/12. This is not full-grader acceptance.",
      "sources": [
        {
          "path": "rex-mle/rexmle/challenges/topcow-track1-task1/grade.py",
          "url": "https://github.com/rajpurkarlab/ReX-MLE/blob/b3d8f7c3ff1df5af46d8f3e5312760af3ad18a53/rex-mle/rexmle/challenges/topcow-track1-task1/grade.py",
