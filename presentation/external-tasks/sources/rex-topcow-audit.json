  "claims": [
    {
      "id": "training-task",
      "observation": "The shared environment instructions require training a model and inference on the test set, forbid hand-labeling and using other solutions, and require submission.csv plus referenced files inside /home/submission. This is an offline adapted split, not the original challenge test set.",
      "sources": [
        {
          "path": "rex-mle/environment/instructions.txt",
          "url": "https://github.com/rajpurkarlab/ReX-MLE/blob/b3d8f7c3ff1df5af46d8f3e5312760af3ad18a53/rex-mle/environment/instructions.txt"
        }
      ]
    },
    {
      "id": "preparation",
      "observation": "The preparer sorts matched CTA image/label filenames, then uses train_test_split(test_size=0.2, random_state=42, shuffle=True). Training images/labels and test images are public; test labels and test_labels.csv are private. Grader and leaderboard are copied into public. ROI and edge annotations are not copied.",
      "sources": [
        {
          "path": "rex-mle/rexmle/challenges/topcow-track1-task1/prepare.py",
          "url": "https://github.com/rajpurkarlab/ReX-MLE/blob/b3d8f7c3ff1df5af46d8f3e5312760af3ad18a53/rex-mle/rexmle/challenges/topcow-track1-task1/prepare.py",
          "symbol": "prepare",
          "start_line": 46,
          "end_line": 281
        }
      ]
    },
    {
      "id": "split-correction",
      "observation": "A complete current ZIP64 directory has 125 matching CTA pairs. Executing the pinned preparer on filename-only placeholders yields 100 train/25 test, with 012 in test. The old preview called its upstream training label a supplied helper while membership was unverified. For this release and preparer it is held-out reference material.",
      "sources": [
        {
          "path": "rex-mle/rexmle/challenges/topcow-track1-task1/prepare.py",
          "url": "https://github.com/rajpurkarlab/ReX-MLE/blob/b3d8f7c3ff1df5af46d8f3e5312760af3ad18a53/rex-mle/rexmle/challenges/topcow-track1-task1/prepare.py",
          "symbol": "prepare",
          "start_line": 46,
          "end_line": 281
        }
      ]
    },
    {
      "id": "target-vocabulary",
      "observation": "The grader has 13 foreground IDs: 1-12 and 15. Zero is background; 13 and 14 are not named target classes. Case012 reference contains 11 foreground IDs; 8 and 15 are absent from that annotation.",
      "sources": [
        {
          "path": "rex-mle/rexmle/challenges/topcow-track1-task1/grade.py",
          "url": "https://github.com/rajpurkarlab/ReX-MLE/blob/b3d8f7c3ff1df5af46d8f3e5312760af3ad18a53/rex-mle/rexmle/challenges/topcow-track1-task1/grade.py"
        }
      ]
    },
    {
      "id": "output-contract",
      "observation": "Description requests image_id, modality=CTA and predicted_mask_path plus native-grid integer masks. The grader validates only image_id and predicted_mask_path, compares ID sets, requires files, and loops over submitted rows. It does not reject duplicate rows or require modality.",
      "sources": [
        {
          "path": "rex-mle/rexmle/challenges/topcow-track1-task1/description.md",
          "url": "https://github.com/rajpurkarlab/ReX-MLE/blob/b3d8f7c3ff1df5af46d8f3e5312760af3ad18a53/rex-mle/rexmle/challenges/topcow-track1-task1/description.md"
