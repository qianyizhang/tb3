# Local runtime evidence and disposable environments. Keep concise evidence in
# docs/evidence and probes/*/authoring/evidence; never blanket-ignore JSON/text.
/.cache/
/.venv*/
/jobs/
/runs/

# Python and developer tooling outputs.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local credentials and machine/editor state.
.env
.env.*
!.env.example
.DS_Store
*.swp
*.swo
*~

# Compilers/debuggers. Vendored source, lockfiles, fixtures and required
# verifier archives remain visible and must be reviewed before staging.
*.dSYM/
*.o
*.obj
*.so
*.dylib
*.dll
*.exe
*.a
*.lib
probes/**/target/
probes/**/CMakeFiles/

# Rebuildable medical tour data and publication exports stay local. Authored
# stories, translations, presets, source code and chapter figures are tracked.
/site_med/tours/data/
/site_med/tours/web/
/site_med/tours/exports/
/site_med/tours/validation.json
/site_med/tours/compression-report.json

# Medical migration recovery and derived presentation.
/archive/legacy/
/presentation/tours/data/
/presentation/tours/web/
/presentation/tours/exports/
/presentation/tours/validation.json
/presentation/tours/compression-report.json
/_site/

# Retired originals are recovered through archive/manifest.json.
/site/
/site_med/
/catalog/
/probes/actuator-memory/
/probes/cache-invalidation/
/probes/chat-round-recovery/
/probes/clamped-instrument/
/probes/clipper-polytree/
