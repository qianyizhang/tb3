{
  "name": "tb3-medical-media",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "media": "node scripts/export_med_tours.mts",
    "format:check": "prettier --check 'scripts/*.mts' 'presentation/tooling/**/*.mts' 'tests/*.cjs' 'tests/*.mts' 'presentation/frontend/**/*.{ts,tsx,css}' 'presentation/assets/teaching/*.js' 'presentation/vite.config.mjs' 'tests/*.mjs' 'presentation/story-language.js'",
    "format": "prettier --write 'scripts/*.mts' 'presentation/tooling/**/*.mts' 'tests/*.cjs' 'tests/*.mts' 'presentation/frontend/**/*.{ts,tsx,css}' 'presentation/assets/teaching/*.js' 'presentation/vite.config.mjs' 'tests/*.mjs' 'presentation/story-language.js'",
    "frontend:build": "npm run typecheck && node scripts/build_frontend.mts",
    "typecheck": "npm run contracts:check && tsc --noEmit && npm run tooling:typecheck",
    "frontend:dev": "npm run frontend:build && uv run --no-sync med present --output .local/frontend-preview && vite --config presentation/vite.config.mjs",
    "contracts:generate": "uv run --no-sync python -m tb3_medical.presentation_contracts",
    "contracts:check": "uv run --no-sync python -m tb3_medical.presentation_contracts --check",
    "tooling:typecheck": "tsc --project tsconfig.tooling.json",
    "visual-review": "node scripts/task_visual_review.mts"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  }
}
