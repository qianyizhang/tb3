{
  "name": "tb3-medical-media",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "media": "node scripts/export_med_tours.cjs",
    "format:check": "prettier --check 'scripts/*.cjs' 'tests/*.cjs' 'presentation/task-explorer/scene*.js' 'scripts/*.mjs' 'presentation/frontend/**/*.{ts,tsx,css}' 'presentation/assets/teaching/*.js' 'presentation/vite.config.mjs' 'tests/*.mjs'",
    "format": "prettier --write 'scripts/*.cjs' 'tests/*.cjs' 'presentation/task-explorer/scene*.js' 'scripts/*.mjs' 'presentation/frontend/**/*.{ts,tsx,css}' 'presentation/assets/teaching/*.js' 'presentation/vite.config.mjs' 'tests/*.mjs'",
    "frontend:build": "npm run typecheck && node scripts/build_frontend.mjs",
    "typecheck": "npm run contracts:check && tsc --noEmit",
    "frontend:dev": "npm run frontend:build && uv run --no-sync med present --output .local/frontend-preview && vite --config presentation/vite.config.mjs",
    "contracts:generate": "uv run --no-sync python -m tb3_medical.presentation_contracts",
    "contracts:check": "uv run --no-sync python -m tb3_medical.presentation_contracts --check"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.63.0",
    "prettier": "3.9.8",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.0"
  }
}
